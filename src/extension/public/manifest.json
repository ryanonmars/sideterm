{
  "manifest_version": 3,
  "name": "SideTerm",
  "version": "0.1.1",
  "description": "A real terminal beside your browser tabs.",
  "key": "",
  "permissions": ["sidePanel", "nativeMessaging"],
  "icons": {
    "16": "icons/sideterm-toolbar.png",
    "32": "icons/sideterm-toolbar.png",
    "48": "icons/sideterm-toolbar.png",
    "128": "icons/sideterm-toolbar.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SideTerm",
    "default_icon": {
      "16": "icons/sideterm-toolbar.png",
      "32": "icons/sideterm-toolbar.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
